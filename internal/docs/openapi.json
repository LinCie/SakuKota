                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Sub-districts"],
        "operationId": "deleteSubDistrict",
        "summary": "Delete a sub-district",
        "description": "Deletes a sub-district. Requires the admin role. Fails with 409 while places reference it.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Sub-district ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "204": {
            "description": "Sub-district deleted successfully. No response body."
          },
          "400": {
            "description": "The sub-district ID is invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_sub_district_id",
                  "message": "invalid sub_district_id"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "The sub-district does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "sub_district_not_found",
                  "message": "sub-district not found"
                }
              }
            }
          },
          "409": {
            "description": "The sub-district is referenced by places.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "sub_district_in_use",
                  "message": "sub-district is referenced by places"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
