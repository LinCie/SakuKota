        }
      },
      "Point": {
        "type": "object",
        "description": "GeoJSON Point in WGS 84 (SRID 4326). Coordinates are [longitude, latitude] and must lie within Indonesia: longitude 95 to 141, latitude -11 to 6.",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "const": "Point" },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        }
      },
      "CreatePlaceRequest": {
        "type": "object",
        "required": ["sub_district_id", "category_id", "name"],
        "properties": {
          "sub_district_id": { "type": "integer", "format": "int64" },
          "category_id": { "type": "integer", "format": "int64" },
          "name": { "type": "string", "minLength": 1, "maxLength": 150 },
          "address": { "type": ["string", "null"], "maxLength": 255 },
          "location": {
            "oneOf": [
              { "$ref": "#/components/schemas/Point" },
              { "type": "null" }
            ]
          },
          "operating_hours": { "type": ["string", "null"], "maxLength": 255 },
          "estimated_price_range": { "type": ["string", "null"], "maxLength": 100 },
          "short_description": { "type": ["string", "null"] },
          "attributes": {
            "type": ["object", "null"],
            "description": "Values for the chosen category's custom fields, keyed by field key. Required fields must be present."
          }
        }
      },
      "UpdatePlaceRequest": {
        "type": "object",
        "description": "Partial update. Keys left out keep their current value. sub_district_id, category_id, and name cannot be null; other nullable fields accept null to clear them.",
        "properties": {
          "sub_district_id": { "type": "integer", "format": "int64" },
          "category_id": { "type": "integer", "format": "int64" },
          "name": { "type": "string", "minLength": 1, "maxLength": 150 },
          "address": { "type": ["string", "null"], "maxLength": 255 },
          "location": {
            "oneOf": [
              { "$ref": "#/components/schemas/Point" },
              { "type": "null" }
            ]
          },
          "operating_hours": { "type": ["string", "null"], "maxLength": 255 },
          "estimated_price_range": { "type": ["string", "null"], "maxLength": 100 },
          "short_description": { "type": ["string", "null"] },
          "attributes": {
            "type": ["object", "null"],
            "description": "Replaces all attributes when set. Must match the fields of the place's category."
          }
        }
      },
      "CategorySummary": {
        "type": "object",
        "required": ["id", "name", "slug", "code", "label", "color"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "code": { "type": "string", "description": "The single character that marks the category on a map sign." },
          "label": { "type": "string", "description": "Short name to display." },
          "color": { "$ref": "#/components/schemas/CategoryColor" }
        }
      },
      "Place": {
        "type": "object",
        "required": [
          "id",
          "sub_district_id",
          "name",
          "address",
          "location",
          "operating_hours",
          "estimated_price_range",
          "short_description",
          "attributes",
          "rating_average",
          "rating_count",
          "category"
        ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "sub_district_id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "address": { "type": ["string", "null"] },
          "location": {
            "oneOf": [
              { "$ref": "#/components/schemas/Point" },
              { "type": "null" }
            ]
          },
          "operating_hours": { "type": ["string", "null"] },
          "estimated_price_range": { "type": ["string", "null"] },
          "short_description": { "type": ["string", "null"] },
          "attributes": {
            "type": "object",
            "description": "Values for the category's custom fields, keyed by field key."
          },
          "rating_average": {
            "type": ["number", "null"],
            "description": "Mean star rating of the place's reviews, from 1 to 5; null before the first review."
          },
          "rating_count": {
            "type": "integer",
            "description": "Number of reviews of the place."
          },
          "category": { "$ref": "#/components/schemas/CategorySummary" }
        }
      },
      "PlaceResponse": {
        "type": "object",
