      "CategoryField": {
        "type": "object",
        "required": ["id", "category_id", "key", "label", "data_type", "required", "options", "sort_order"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "category_id": { "type": "integer", "format": "int64" },
          "key": { "type": "string" },
          "label": { "type": "string" },
          "data_type": { "$ref": "#/components/schemas/FieldDataType" },
