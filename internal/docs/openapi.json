          "id": { "type": "integer", "format": "int64" },
          "place_id": { "type": "integer", "format": "int64" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "user": { "$ref": "#/components/schemas/ReviewAuthor" }
        }
      },
      "ReviewResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Review" }
        }
      },
      "CategoryDetail": {
        "type": "object",
        "required": ["id", "name", "slug", "code", "label", "color", "fields"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "code": { "type": "string", "description": "The single character that marks the category on a map sign." },
          "label": { "type": "string", "description": "Short name to display." },
          "color": { "$ref": "#/components/schemas/CategoryColor" },
          "fields": {
            "type": "array",
