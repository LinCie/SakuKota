        "properties": {
          "data": { "$ref": "#/components/schemas/Place" }
        }
      },
      "CreateReviewRequest": {
        "type": "object",
        "required": ["rating"],
        "properties": {
          "rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Number of stars." },
          "comment": {
            "type": ["string", "null"],
            "maxLength": 1000,
            "description": "Optional. Trimmed; a blank comment is stored as null."
          }
        }
      },
      "ReviewAuthor": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "Review": {
        "type": "object",
        "required": ["id", "place_id", "rating", "comment", "created_at", "user"],
