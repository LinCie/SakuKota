{
  "openapi": "3.1.0",
  "info": {
    "title": "Rantau API",
    "version": "1.0.0",
    "description": "API for sub-districts, places, place reviews, place categories, and authentication. Successful JSON responses are wrapped in data; errors contain code and message."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Register users, authenticate, and manage refresh-token sessions."
    },
    {
      "name": "Places",
      "description": "List, get, create, update, and delete places."
    },
    {
      "name": "Reviews",
      "description": "List and write star ratings and comments for places. Each user reviews a place at most once."
    },
    {
      "name": "Categories",
      "description": "List and get place categories with their custom fields. Categories and their fields are defined in the database migrations."
    },
    {
      "name": "Sub-districts",
      "description": "List, read, create, update, and delete sub-districts."
    }
  ],
  "paths": {
    "/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "operationId": "register",
        "summary": "Register a user",
        "description": "Creates a user and returns their ID, name, and email. No tokens or cookies are issued; log in separately to authenticate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "example": {
                "name": "Jane Doe",
                "email": "jane@example.com",
                "password": "correct-horse-battery-staple"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": {
            "description": "A user with this email already exists.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "email_taken",
                  "message": "email already registered"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "operationId": "login",
        "summary": "Log in",
        "description": "Authenticates a user and issues an access token. The refresh token is set in an HttpOnly cookie and is not included in the response body.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "email": "jane@example.com",
                "password": "correct-horse-battery-staple"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful. The refresh token cookie is set.",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly refresh_token cookie scoped to /v1/auth; SameSite=Strict and Secure according to server configuration.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "The email or password is incorrect.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_credentials",
                  "message": "invalid email or password"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "operationId": "refreshSession",
        "summary": "Refresh session",
        "description": "Rotates the refresh token and issues a new access token. The refresh token is read from and replaced in the HttpOnly cookie.",
        "security": [{ "RefreshTokenCookie": [] }],
        "responses": {
          "200": {
            "description": "Session refreshed successfully.",
            "headers": {
              "Set-Cookie": {
                "description": "Replacement HttpOnly refresh_token cookie scoped to /v1/auth; SameSite=Strict and Secure according to server configuration.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionResponse" }
              }
            }
          },
          "401": {
            "description": "The refresh token cookie is missing, or the refresh token is invalid or expired. The cookie is cleared when the token is invalid or expired.",
            "headers": {
              "Set-Cookie": {
                "description": "Expired refresh_token cookie scoped to /v1/auth.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_refresh_token",
                  "message": "invalid or expired refresh token"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "operationId": "logout",
        "summary": "Log out",
        "description": "Revokes the refresh-token session if a refresh_token cookie is present, then clears the cookie. Calling without the cookie is also successful.",
        "responses": {
          "204": {
            "description": "Logged out successfully. No response body.",
            "headers": {
              "Set-Cookie": {
                "description": "Expired refresh_token cookie scoped to /v1/auth.",
                "schema": { "type": "string" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/places": {
      "get": {
        "tags": ["Places"],
        "operationId": "listPlaces",
        "summary": "List places",
        "description": "Returns places, optionally filtered. Filters are combined with AND.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive search across place name, address, short description, and category name.",
            "schema": { "type": "string" }
          },
          {
            "name": "sub_district_id",
            "in": "query",
            "description": "Only return places in this sub-district.",
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "category_id",
            "in": "query",
            "description": "Comma-separated category IDs. Returns places in any of the given categories.",
            "schema": {
              "type": "string",
              "example": "1,3"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "description": "Only return places located inside this box, edges included, as west,south,east,north in degrees. West must not exceed east, nor south north. Places without a location are left out.",
            "schema": {
              "type": "string",
              "example": "106.8084,-6.2292,106.8451,-6.2009"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Return at most this many places, lowest IDs first. total still counts every match.",
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Places retrieved successfully, with the number of matches before the limit. An empty result returns an empty places array and a total of 0.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["places", "total"],
                      "properties": {
                        "places": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Place" }
                        },
                        "total": {
                          "type": "integer",
                          "description": "Places matching the filters, including those cut off by limit."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "sub_district_id or category_id is not a valid positive integer, limit is not a positive integer, or bbox is not four valid coordinates (invalid_sub_district_id, invalid_category_id, invalid_limit, invalid_bbox).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_category_id",
                  "message": "invalid category_id"
                }
              }
            }
          },
          "404": {
            "description": "The sub-district or category filter refers to an ID that does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "sub_district_not_found",
                  "message": "sub-district not found"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["Places"],
        "operationId": "createPlace",
        "summary": "Create a place",
        "description": "Creates a place. Requires the admin role. The attributes object must match the fields of the chosen category: required fields must be present, and unknown keys are rejected.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePlaceRequest" },
              "example": {
                "sub_district_id": 1,
                "category_id": 1,
                "name": "Warung Bu Sri",
                "address": "Jl. Melati No. 5",
                "location": {
                  "type": "Point",
                  "coordinates": [106.8456, -6.2088]
                },
                "operating_hours": "07:00-21:00",
                "estimated_price_range": "Rp 10.000-25.000",
                "short_description": "Nasi campur and soto.",
                "attributes": {
                  "halal": true,
                  "serving_style": "Dimasak saat dipesan"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Place created successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlaceResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/places/{id}": {
      "get": {
        "tags": ["Places"],
        "operationId": "getPlace",
        "summary": "Get a place",
        "description": "Returns a place with its category.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Place ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Place retrieved successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlaceResponse" }
              }
            }
          },
          "400": {
            "description": "The place ID is invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_place_id",
                  "message": "invalid place_id"
                }
              }
            }
          },
          "404": {
            "description": "The place does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "place_not_found",
                  "message": "place not found"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "patch": {
        "tags": ["Places"],
        "operationId": "updatePlace",
        "summary": "Update a place",
        "description": "Partially updates a place. Requires the admin role. Keys left out keep their current value, and nullable fields accept null to clear them. If category_id or attributes change, the attributes are validated against the category's fields.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Place ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdatePlaceRequest" },
              "example": {
                "name": "Warung Bu Sri Pusat",
                "operating_hours": "08:00-22:00"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Place updated successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlaceResponse" }
              }
            }
          },
          "400": {
            "description": "The place ID is invalid, the body is malformed, a required field is set to null, or a value failed validation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "validation_error",
                  "message": "name is required"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "The place does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "place_not_found",
                  "message": "place not found"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Places"],
        "operationId": "deletePlace",
        "summary": "Delete a place",
        "description": "Deletes a place. Requires the admin role.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Place ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "204": {
            "description": "Place deleted successfully. No response body."
          },
          "400": {
            "description": "The place ID is invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_place_id",
                  "message": "invalid place_id"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "The place does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "place_not_found",
                  "message": "place not found"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/places/{id}/reviews": {
      "get": {
        "tags": ["Reviews"],
        "operationId": "listPlaceReviews",
        "summary": "List a place's reviews",
        "description": "Returns the place's reviews with their authors, newest first.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Place ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Reviews retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Review" }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The place ID is invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_place_id",
                  "message": "invalid place_id"
                }
              }
            }
          },
          "404": {
            "description": "The place does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "place_not_found",
                  "message": "place not found"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["Reviews"],
        "operationId": "createPlaceReview",
        "summary": "Review a place",
        "description": "Stores the signed-in user's star rating and optional comment for the place, and adds the rating to the place's rating_average and rating_count. Any signed-in user may review, and each user reviews a place at most once. The comment is trimmed, a blank comment is stored as null, and it may be at most 1000 characters.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Place ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateReviewRequest" },
              "example": {
                "rating": 4,
                "comment": "Murah dan porsinya besar."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review created successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReviewResponse" }
              }
            }
          },
          "400": {
            "description": "The place ID is invalid, the body is malformed, or a value failed validation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "validation_error",
                  "message": "rating must be between 1 and 5"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "The place does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "place_not_found",
                  "message": "place not found"
                }
              }
            }
          },
          "409": {
            "description": "The user has already reviewed this place.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "already_reviewed",
                  "message": "place already reviewed by this user"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/places/categories": {
      "get": {
        "tags": ["Categories"],
        "operationId": "listCategories",
        "summary": "List categories",
        "description": "Returns all categories with their custom fields.",
        "responses": {
          "200": {
            "description": "Categories retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/CategoryDetail" }
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/places/categories/{id}": {
      "get": {
        "tags": ["Categories"],
        "operationId": "getCategory",
        "summary": "Get a category",
        "description": "Returns a category with its custom fields.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Category ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Category retrieved successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CategoryDetailResponse" }
              }
            }
          },
          "400": {
            "description": "The category ID is invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_category_id",
                  "message": "invalid category_id"
                }
              }
            }
          },
          "404": {
            "description": "The category does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "category_not_found",
                  "message": "category not found"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/subdistricts": {
      "get": {
        "tags": ["Sub-districts"],
        "operationId": "listSubDistricts",
        "summary": "List sub-districts",
        "responses": {
          "200": {
            "description": "Sub-districts retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/SubDistrict" }
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["Sub-districts"],
        "operationId": "createSubDistrict",
        "summary": "Create a sub-district",
        "description": "Creates a sub-district. Requires the admin role.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSubDistrictRequest" },
              "example": {
                "name": "Kebayoran Baru",
                "slug": "kebayoran-baru",
                "estimated_daily_spending": 150000
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sub-district created successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubDistrictResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "A sub-district with this name or slug already exists.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "sub_district_exists",
                  "message": "sub-district with this name or slug already exists"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/subdistricts/{id}": {
      "get": {
        "tags": ["Sub-districts"],
        "operationId": "getSubDistrict",
        "summary": "Get a sub-district",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Sub-district ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Sub-district retrieved successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubDistrictResponse" }
              }
            }
          },
          "400": {
            "description": "The sub-district ID is invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "invalid_sub_district_id",
                  "message": "invalid sub_district_id"
                }
              }
            }
          },
          "404": {
            "description": "The sub-district does not exist.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "code": "sub_district_not_found",
                  "message": "sub-district not found"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "patch": {
        "tags": ["Sub-districts"],
        "operationId": "updateSubDistrict",
        "summary": "Update a sub-district",
        "description": "Partially updates a sub-district. Requires the admin role.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Sub-district ID.",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSubDistrictRequest" },
              "example": {
                "estimated_daily_spending": 175000
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-district updated successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubDistrictResponse" }
              }
            }
          },
          "400": {
