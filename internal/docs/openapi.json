          "slug": { "type": "string", "minLength": 1, "maxLength": 100 },
          "flood_history": { "type": ["string", "null"] },
          "safety_crime_information": { "type": ["string", "null"] },
          "estimated_daily_spending": { "type": ["number", "null"], "minimum": 0, "maximum": 99999999.99 },
          "static_map_image_url": { "type": ["string", "null"], "maxLength": 255 }
        }
      },
      "UpdateSubDistrictRequest": {
        "type": "object",
        "description": "Partial update. Keys left out keep their current value. name and slug cannot be null; other nullable fields accept null to clear them.",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "slug": { "type": "string", "minLength": 1, "maxLength": 100 },
          "flood_history": { "type": ["string", "null"] },
          "safety_crime_information": { "type": ["string", "null"] },
          "estimated_daily_spending": { "type": ["number", "null"], "minimum": 0, "maximum": 99999999.99 },
          "static_map_image_url": { "type": ["string", "null"], "maxLength": 255 }
        }
      },
      "SubDistrict": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "flood_history",
          "safety_crime_information",
          "estimated_daily_spending",
          "static_map_image_url"
        ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "flood_history": { "type": ["string", "null"] },
          "safety_crime_information": { "type": ["string", "null"] },
          "estimated_daily_spending": { "type": ["number", "null"] },
          "static_map_image_url": { "type": ["string", "null"] }
        }
      },
      "SubDistrictResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/SubDistrict" }
        }
