# Base URL the browser calls the API at. /api goes through the dev server's
# proxy (and nginx in the container), keeping the refresh cookie first-party.
VITE_API_URL=/api

# Dev server only. `make dev` sets API_PROXY_TARGET from PORT in the root .env.
# The API that /api is proxied to.
API_PROXY_TARGET=http://localhost:8080
# Port of the dev server; keep CORS_ALLOWED_ORIGIN in the root .env in sync.
DEV_PORT=5173
