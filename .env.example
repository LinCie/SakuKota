DATABASE_URL=postgres://postgres:postgres@localhost:5432/rantaugo?sslmode=disable
REDIS_URL=redis://localhost:6379/0
PORT=8080
MIGRATIONS_DIR=migrations

POSTGRES_DB=rantaugo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

# Local development over plain HTTP only; keep refresh cookies Secure elsewhere.
COOKIE_SECURE=false

# Origin of the web app, allowed by the image bucket's CORS rule (browsers upload to it directly).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Signs access tokens. Required: replace with a long random string.
JWT_SECRET=change-me

# Image storage (Garage, see `make storage-up`). The key pair below is imported
# into the local node by `make storage-init`; use real secrets elsewhere.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_PUBLIC_ENDPOINT=http://localhost:3900
STORAGE_PUBLIC_URL=http://rantau-images.web.localhost:3902
STORAGE_REGION=garage
STORAGE_BUCKET=rantau-images
STORAGE_ACCESS_KEY_ID=GKdb250aca7601f205999bb10d
