DATABASE_URL=postgres://postgres:postgres@localhost:5432/rantaugo?sslmode=disable
PORT=8080
MIGRATIONS_DIR=migrations

POSTGRES_DB=rantaugo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Local development over plain HTTP only; keep refresh cookies Secure elsewhere.
COOKIE_SECURE=false

# Origin of the web app, for CORS.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Signs access tokens. Required: replace with a long random string.
JWT_SECRET=change-me
