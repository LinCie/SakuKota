# Local development values only. `cp .env.example .env` gives a working setup
# for both `make dev` and `docker compose up`; use real secrets anywhere else.

# Container engine used by the Makefile: docker or podman.
CONTAINER_ENGINE=docker

DATABASE_URL=postgres://postgres:postgres@localhost:5432/sakukotago?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# API port on the host; `make dev` points the web dev server's proxy at it.
PORT=8080
MIGRATIONS_DIR=migrations

POSTGRES_DB=sakukotago
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

# Local development over plain HTTP only; keep refresh cookies Secure elsewhere.
COOKIE_SECURE=false

# Origin of the web app, allowed by the image bucket's CORS rule (browsers upload to it directly).
# This is the Vite dev server (DEV_PORT in web/.env); the compose stack uses
# http://localhost:$WEB_PORT instead.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Signs access tokens; at least 32 bytes. Generate your own with: openssl rand -hex 32
JWT_SECRET=4f9c1d7e2a6b8053c1e9f4a27d6b0e3895c2a1f7e4d8b6093a5c7e1f2d4b8a60
# Token lifetimes.
JWT_EXPIRES_MINUTES=5
REFRESH_TOKEN_EXPIRES_DAYS=30

# Image storage (Garage, see `make storage-up`). The key pair below is imported
# into the local node by `make storage-init`.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_PUBLIC_ENDPOINT=http://localhost:3900
STORAGE_PUBLIC_URL=http://sakukota-images.web.localhost:3902
STORAGE_REGION=garage
STORAGE_BUCKET=sakukota-images
STORAGE_ACCESS_KEY_ID=GKdb250aca7601f205999bb10d
STORAGE_SECRET_ACCESS_KEY=23cbdba1469c0297384fffa260c19a87bf534dc68181c260bfdcb624a7cfe77e
# Shared secret of the Garage node's RPC (compose.yaml).
GARAGE_RPC_SECRET=ab585f3faae621737dbe043edb29dfe69a95d3194d76218cda428e47c2f25338

# Optional API listeners and telemetry, all off when empty. compose.yaml sets
# the metrics and OTLP values for the api container itself.
# Prometheus /metrics listener, e.g. :9464.
METRICS_ADDR=
# net/http/pprof listener, e.g. localhost:6060 (see scripts/pprof.sh).
PPROF_ADDR=
OTEL_SERVICE_NAME=sakukota-go
# OTLP/HTTP trace endpoint, e.g. http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP/HTTP log endpoint, e.g. http://localhost:3100/otlp/v1/logs.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# Host ports of the compose stack.
WEB_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
